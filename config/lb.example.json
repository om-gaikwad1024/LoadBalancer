{
  "listen": {
    "address": "127.0.0.1",
    "port": 8080
  },
  "workers": {
    "threads": "auto"
  },
  "limits": {
    "max_request_line_bytes": 8192,
    "max_request_header_bytes": 32768,
    "max_request_header_count": 100,
    "max_response_header_bytes": 65536,
    "max_response_header_count": 200,
    "max_chunk_line_bytes": 4096
  },
  "groups": [
    {
      "name": "web",
      "backends": [
        { "id": "web-1", "address": "127.0.0.1", "port": 9001, "weight": 1 },
        { "id": "web-2", "address": "127.0.0.1", "port": 9002, "weight": 1 },
        { "id": "web-3", "address": "127.0.0.1", "port": 9003, "weight": 1 }
      ]
    }
  ],
  "routing": {
    "default_group": "web"
  }
}
